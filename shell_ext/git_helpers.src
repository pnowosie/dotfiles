# Git helpers
GITHUB_SSH_KEY_PATH="${HOME}/.ssh/id_rsa"

# Aliases
alias g=git
alias gad='git add . ; git status'
# masta / mastap are functions (see below) -- they detect main vs master
alias gee='git l | tee'
alias bee='git b | tee'
alias shl='git stash list'
alias shap='git stash apply'
alias shop='git stash pop'

# Branch clean up

#[DOC]: Deletes local branches which already have been merged
alias rm-merged='merged-branches | xargs git branch -d'

#[DOC]: Cleans up remote tracking branches
alias rm-tracking='git remote prune origin'


# Simple aliases are defined in .gitconfig

# Functions

#[DOC]: Prints the checked out branch (empty when HEAD is detached)
function currbranch() {
  git branch --show-current
}

#[DOC]: Prints this repo's default branch - main or master, whichever exists
function mainbranch() {
  git branch --format='%(refname:short)' | grep -m1 -E '^(main|master)$'
}

#[DOC]: Checks out the default branch; extra args go to git checkout
function masta() {
  local branch
  branch=$(mainbranch) || {
    say $RED "Neither main nor master here" >&2
    return 1
  }
  git checkout "$@" "$branch"
}

#[DOC]: masta + git pull
function mastap() {
  masta && git pull
}

#[DOC]: Throws away local changes and jumps to the default branch
function mastaf() {
  git clean -fd && masta -f
}

#[DOC]: Starts a task branch off a fresh default branch
#> jira SUP-8400
#> jira https://invia.atlassian.net/browse/SUP-8400
function jira() {
  local id
  id=$(echo "$1" | grep -oiE 'SUP-[0-9]+' | tr '[:lower:]' '[:upper:]')
  [[ -z "$id" ]] && {
    say $RED "Need a SUP ticket id or url, e.g. SUP-8400" >&2
    return 1
  }

  mastap && git checkout -b "$id"
}

#[DOC]: Am I on the default branch?
function onmaster() {
    local main
    main=$(mainbranch) || return 1
    [[ "$(currbranch)" == "$main" ]]
}

# std rebase feature branch onto the default branch, or just pull when on it
function rebase() {
    local main
    main=$(mainbranch) || return 1

    if onmaster; then
        git pull
        say $BLUE "ready on ${main}"
    else
        local branch
        branch=$(currbranch)
        mastap || return 1
        git checkout "$branch"
        runtest git rebase "$main"
    fi
}

# Updates (resets) to the remote upstream branch potencially loosing local history
function reset-to-upstream() {
    if onmaster; then
        say $RED "don't hard-reset $(mainbranch), please!"
    else
        git fetch --all
        git reset --hard origin/$(currbranch)
    fi
}

# check whether working copy is up to date with upstream
function curr() {
    local uptodate="Your branch is up to date"
    git fetch

    local stan
    stan=$(git status --ahead-behind)
    if echo "$stan" | grep -q "$uptodate"; then
        say $GREEN "$uptodate"
    else
        echo "$stan"
    fi
}

# picks a current HEAD sha
function hed() {
  git log --color -1 --abbrev-commit --pretty=format:'%C(bold white)%h%Creset (%Cblue%an%Creset %Cgreen%cr%Creset) %C(bold white)*%Creset %C(bold)%s%Creset ' | tee
}

# switch branch based on part of the name
function bb() {
  local branch
  branch=$(git branch --format='%(refname:short)' | grep "$1")

  if [[ -z "$branch" ]]; then
    say $RED "No branch matching the pattern" >&2
    return 1
  fi

  if [[ $(echo "$branch" | wc -l) -ne 1 ]]; then
    echo "$branch"
    say $RED "More than one possible branch" >&2
    return 2
  fi

  if [[ "$branch" == "$(currbranch)" ]]; then
    say $BLUE "Already current branch"
    return 0
  fi

  echo "Switching to branch: ${branch}"
  git checkout "$branch"
}

function ssh-agent-start() {
  eval "$(ssh-agent -s)"
  ssh-add "${GITHUB_SSH_KEY_PATH}"
}

# Applies a git stash entry and resolve conflict to the applied changes
# USE WITH CAUTION - will wipe new things out when your entry in stash is old
function stasio() {
  stash_id=$1
  [[ -z "${stash_id}" ]] && stash_id=0
  git stash apply ${stash_id}
  if [[ $? != 0 ]]; then
    echo "we have a conflict! - resolving"
    git checkout --theirs -- .
    git add .
    git restore --staged .
  fi

  git status
}

#[DOC]: Merged local branches, minus the current one and main/master/dev
# You can exclude more patterns by adding to the last grep
function merged-branches() {
  git branch --merged \
    | grep -v '^\*' \
    | tr -d ' ' \
    | grep -vE '^(main|master|dev)$'
}

# Helper function to delete old merged tracking local branches
function drop-old() {
  git remote prune origin

  merged-branches > /tmp/merged-branches

  # allow to check & rescue some local branches
  ${EDITOR} /tmp/merged-branches

  xargs git branch -d < /tmp/merged-branches
}

function get-pr() {
  pr_id="$1"
  echo "Fetching branch from PR#${pr_id}"
  git fetch origin "pull/${pr_id}/head:prs/${pr_id}"
  git checkout "prs/${pr_id}"
}

# Fetches the head of upstream's default branch and updates local copy and origin
function pull-upstream() {
  local main
  main=$(mainbranch) || return 1

  mastap || return 1

  echo "Fetched upstream : ${main}"
  git fetch upstream "$main"

  echo "Update local and origin"
  git merge --ff-only "upstream/${main}"
  git push origin "$main"
}

## Git helpers ##

# Append a log line to a file
# Usage: log_entry <message> <log_file>
log_entry() {
    echo "$1" >> "$2"
}

# Parse git pull output and log a summary
# Usage: parse_git_output <git_output> <repo_name> <log_file>
parse_git_output() {
    local output="$1"
    local subdir="$2"
    local log_file="$3"

    log_entry "- $subdir" "$log_file"

    if echo "$output" | grep -q "Updating [a-f0-9]\+\.\.[a-f0-9]\+"; then
        local update_line=$(echo "$output" | grep "Updating [a-f0-9]\+\.\.[a-f0-9]\+")
        log_entry "$update_line" "$log_file"
    fi

    if echo "$output" | grep -q "[0-9]\+ files changed"; then
        local files_line=$(echo "$output" | grep "[0-9]\+ files changed")
        log_entry "$files_line" "$log_file"
    fi

    if echo "$output" | grep -q "Already up to date"; then
        local current_commit=$(git log --oneline -1)
        log_entry "Already up to date $current_commit" "$log_file"
    fi
}
